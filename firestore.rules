rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function currentUser() {
      return get(userPath(request.auth.uid));
    }

    function currentRole() {
      return currentUser().data.role;
    }

    function currentStatus() {
      return currentUser().data.status;
    }

    function currentClubId() {
      return currentUser().data.clubId;
    }

    function currentPromoterCode() {
      return currentUser().data.promoterCode;
    }

    function referralCodePath(code) {
      return /databases/$(database)/documents/referralCodes/$(code);
    }

    function isApproved() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && currentStatus() == 'approved'
        && currentUser().data.isActive == true;
    }

    function isSuperAdmin() {
      return isApproved() && currentRole() == 'superAdmin';
    }

    function isPromoter() {
      return isApproved() && currentRole() == 'promoter';
    }

    function isClubAdmin() {
      return isApproved() && currentRole() == 'clubAdmin';
    }

    function isUser() {
      return isApproved() && currentRole() == 'user';
    }

    function validRequestedProfile(uid) {
      return request.resource.data.uid == uid
        && request.resource.data.role in ['user', 'promoter', 'clubAdmin']
        && (
          (request.resource.data.role == 'user'
            && request.resource.data.status == 'approved'
            && request.resource.data.promoterCode == null)
          || (request.resource.data.role == 'promoter'
            && request.resource.data.status in ['approved', 'pending_review']
            && request.resource.data.promoterCode is string
            && request.resource.data.promoterCode.size() > 0)
          || (request.resource.data.role == 'clubAdmin'
            && request.resource.data.status == 'pending_review'
            && request.resource.data.promoterCode == null)
        )
        && request.resource.data.isActive == true
        && request.resource.data.keys().hasOnly([
          'uid',
          'title',
          'name',
          'email',
          'phone',
          'profileImageUrl',
          'profilePhotoUrl',
          'photoUrl',
          'gender',
          'dob',
          'instagramId',
          'snapchatId',
          'validIdUrl',
          'verificationStatus',
          'idVerificationStatus',
          'documentUploadStatus',
          'onboardingCompleted',
          'rejectionReason',
          'businessName',
          'venueName',
          'gstNumber',
          'ownerName',
          'businessPhone',
          'businessAddress',
          'city',
          'instagramLink',
          'role',
          'status',
          'clubId',
          'promoterCode',
          'createdAt',
          'updatedAt',
          'isActive'
        ]);
    }

    match /users/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && validRequestedProfile(uid)
        && request.resource.data.role != 'superAdmin';

      allow read: if isSuperAdmin() || (signedIn() && request.auth.uid == uid);

      allow update: if isSuperAdmin()
        || (
          signedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'name',
            'phone',
            'lastKnownCity',
            'profileImageUrl',
            'profilePhotoUrl',
            'photoUrl',
            'validIdUrl',
            'verificationStatus',
            'idVerificationStatus',
            'documentUploadStatus',
            'onboardingCompleted',
            'businessName',
            'venueName',
            'gstNumber',
            'ownerName',
            'businessPhone',
            'businessAddress',
            'city',
            'instagramLink',
            'documentUrl',
            'clubId',
            'status',
            'updatedAt'
          ])
          && request.resource.data.role == resource.data.role
          && request.resource.data.isActive == resource.data.isActive
          && (
            !request.resource.data.diff(resource.data).changedKeys().hasAny([
              'validIdUrl',
              'verificationStatus',
              'idVerificationStatus'
            ])
            || (
              request.resource.data.validIdUrl is string
              && request.resource.data.validIdUrl.size() > 0
              && request.resource.data.verificationStatus == 'pending_review'
              && request.resource.data.idVerificationStatus == 'pending_review'
            )
            || (
              request.resource.data.onboardingCompleted == true
              && request.resource.data.verificationStatus == 'pending_review'
              && request.resource.data.status == 'pending_review'
              && request.resource.data.documentUploadStatus in [
                'pending_upload',
                'uploaded_pending_review'
              ]
            )
          )
          && (
            resource.data.role != 'clubAdmin'
            || request.resource.data.status == 'pending_review'
            || request.resource.data.status == resource.data.status
          )
        );

      allow delete: if isSuperAdmin();
    }

    match /clubs/{clubId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.verificationStatus == 'pending_review';

      allow read: if isSuperAdmin()
        || (signedIn() && resource.data.ownerId == request.auth.uid);

      allow update: if isSuperAdmin()
        || (
          signedIn()
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.verificationStatus == 'pending_review'
        );

      allow delete: if isSuperAdmin();
    }

    match /events/{eventId} {
      allow read: if isSuperAdmin()
        || resource.data.isActive == true
        || (isClubAdmin() && (
          resource.data.createdBy == request.auth.uid
          || resource.data.clubId == currentClubId()
        ));

      allow create: if isSuperAdmin()
        || (
          isClubAdmin()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.clubId == currentClubId()
        );

      allow update, delete: if isSuperAdmin()
        || (
          isClubAdmin()
          && (
            resource.data.createdBy == request.auth.uid
            || resource.data.clubId == currentClubId()
          )
          && request.resource.data.clubId == resource.data.clubId
        );
    }

    match /rsvps/{rsvpId} {
      allow read: if isSuperAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid)
        || (isPromoter() && resource.data.promoterCode == currentPromoterCode())
        || (isClubAdmin() && resource.data.clubId == currentClubId());

      allow create: if isUser()
        && rsvpId == request.auth.uid + '_' + request.resource.data.eventId
        && !exists(/databases/$(database)/documents/rsvps/$(rsvpId))
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.paymentMethod == 'pay_at_venue'
        && request.resource.data.paymentStatus == 'pending_at_venue'
        && request.resource.data.rsvpStatus == 'confirmed'
        && request.resource.data.status == 'confirmed'
        && request.resource.data.venueId is string
        && request.resource.data.venueId.size() > 0
        && request.resource.data.keys().hasOnly([
          'userId',
          'userName',
          'userPhone',
          'eventId',
          'venueId',
          'eventTitle',
          'clubId',
          'promoterId',
          'promoterCode',
          'paymentMethod',
          'paymentStatus',
          'rsvpStatus',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && exists(/databases/$(database)/documents/events/$(request.resource.data.eventId))
        && get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.isActive == true
        && (
          (
            !request.resource.data.keys().hasAny(['clubId'])
            && (
              !get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.keys().hasAny(['clubId'])
              || get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.clubId == null
            )
          )
          || request.resource.data.clubId ==
            get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.clubId
        )
        && (
          !request.resource.data.keys().hasAny(['promoterId', 'promoterCode'])
          || (
            request.resource.data.promoterId is string
            && request.resource.data.promoterCode is string
            && exists(referralCodePath(request.resource.data.promoterCode))
            && get(referralCodePath(request.resource.data.promoterCode)).data.isActive == true
            && get(referralCodePath(request.resource.data.promoterCode)).data.promoterId ==
              request.resource.data.promoterId
            && get(referralCodePath(request.resource.data.promoterCode)).data.referralCode ==
              request.resource.data.promoterCode
          )
        );

      allow update, delete: if isSuperAdmin()
        || (isClubAdmin() && resource.data.clubId == currentClubId());
    }

    match /promoters/{promoterId} {
      allow create: if isSuperAdmin()
        || (
          signedIn()
          && promoterId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.referralCode == currentPromoterCode()
          && request.resource.data.isActive == true
          && request.resource.data.totalRsvps == 0
          && request.resource.data.keys().hasOnly([
            'userId',
            'name',
            'phone',
            'email',
            'referralCode',
            'totalRsvps',
            'createdAt',
            'updatedAt',
            'isActive'
          ])
        );

      allow read: if isSuperAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid)
        || (isPromoter() && resource.data.referralCode == currentPromoterCode());

      allow update, delete: if isSuperAdmin();
    }

    match /referrals/{referralId} {
      allow read: if isSuperAdmin()
        || (isPromoter() && resource.data.promoterCode == currentPromoterCode());
      allow create, update, delete: if isSuperAdmin();
    }

    match /referralCodes/{code} {
      allow read: if signedIn() && resource.data.isActive == true;

      allow create: if isSuperAdmin()
        || (
          isPromoter()
          && request.resource.data.promoterId == request.auth.uid
          && request.resource.data.referralCode == code
          && request.resource.data.referralCode == currentPromoterCode()
          && request.resource.data.isActive == true
          && request.resource.data.keys().hasOnly([
            'promoterId',
            'referralCode',
            'isActive',
            'createdAt',
            'updatedAt'
          ])
        );

      allow update: if isSuperAdmin()
        || (
          isPromoter()
          && resource.data.promoterId == request.auth.uid
          && request.resource.data.promoterId == request.auth.uid
          && request.resource.data.referralCode == code
          && resource.data.referralCode == currentPromoterCode()
          && request.resource.data.isActive == true
          && request.resource.data.keys().hasOnly([
            'promoterId',
            'referralCode',
            'isActive',
            'createdAt',
            'updatedAt'
          ])
        );

      allow delete: if isSuperAdmin();
    }

    match /platform/{documentId} {
      allow read, create, update, delete: if isSuperAdmin();
    }
  }
}
